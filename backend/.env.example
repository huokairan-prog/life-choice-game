# development | test | production. Production refuses simulated payments.
APP_ENV=development
# Use 0.0.0.0 only for a trusted local network preview (for example, testing on your phone).
LIFE_HOST=0.0.0.0
LIFE_PORT=8787
LIFE_DB_PATH=backend/data/life_choice.db

# Must be a high-entropy secret (32+ characters) in production. Do not commit a real value.
AUTH_JWT_SECRET=replace-with-a-32-character-or-longer-secret
DEV_AUTH_SECRET=development-only-local-secret
GROWTH_QUOTE_TTL_SECONDS=120

# WeChat Pay v3. Required only in production payment mode.
WECHAT_PAY_MCHID=
WECHAT_PAY_APPID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY_SERIAL=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=https://your-domain.example/api/payments/wechat/notify
